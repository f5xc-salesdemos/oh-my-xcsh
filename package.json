{
	"name": "xcsh-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"install:dev": "bun install && bun --cwd=packages/coding-agent link && bun --cwd=packages/ai link && bun run ensure:dependencies",
		"check:dependencies": "bun scripts/check-installed-dependencies.ts",
		"ensure:dependencies": "bun scripts/check-installed-dependencies.ts --repair",
		"dev": "bun run ensure:dependencies && bun --preload ./scripts/dev-vertex-credentials.ts packages/coding-agent/src/cli.ts",
		"stats": "bun run ensure:dependencies && bun packages/coding-agent/src/cli.ts stats",
		"build": "bun run ensure:dependencies && bun run --workspaces --if-present build",
		"build:native": "bun --cwd=packages/natives run build",
		"test": "bun run --parallel test:ts test:rs",
		"test:ts": "bun run ensure:dependencies && bun run --workspaces --if-present test -- --only-failures",
		"test:rs": "bun scripts/run-rs-task.ts test:rs",
		"check": "bun run --parallel check:ts check:rs",
		"check:ts": "bun run ensure:dependencies && bun run check:tools && bun run --workspaces --if-present check",
		"check:tools": "biome check packages biome.json --no-errors-on-unmatched && bun run check:types",
		"check:types": "tsgo -p tsconfig.tools.json --noEmit",
		"check:rs": "bun scripts/run-rs-task.ts check:rs",
		"check:docs-quality": "python3 scripts/check_docs_quality.py && python3 -m unittest tests.test_docs_quality",
		"lint": "bun run --parallel lint:ts lint:rs",
		"lint:ts": "bun run lint:tools && bun run --workspaces --if-present lint",
		"pii:gate": "bash scripts/pii-gate.sh",
		"lint:tools": "biome lint . --no-errors-on-unmatched",
		"lint:rs": "bun scripts/run-rs-task.ts lint:rs",
		"fmt": "bun run --parallel fmt:ts fmt:rs",
		"fmt:ts": "bun run fmt:tools && bun run --workspaces --if-present fmt",
		"fmt:tools": "biome format --write . --no-errors-on-unmatched",
		"fmt:rs": "bun scripts/run-rs-task.ts fmt:rs",
		"fix": "bun run --parallel fix:ts fix:rs",
		"fix:ts": "bun run fix:tools && bun run --workspaces --if-present fix",
		"fix:tools": "bun run fmt:tools && biome check --write --unsafe . --no-errors-on-unmatched",
		"fix:rs": "bun scripts/run-rs-task.ts fix:rs",
		"validate:i18n": "bun scripts/validate-i18n.ts",
		"ci:check:full": "bun run check:ts && bun run check:docs-quality",
		"ci:build:native": "bun scripts/ci-build-native.ts",
		"ci:test:full": "bun run test",
		"ci:test:smoke": "bun packages/coding-agent/src/cli.ts --version && bun packages/coding-agent/src/cli.ts --help && bun packages/coding-agent/src/cli.ts stats --help && bun packages/coding-agent/src/cli.ts validate --help",
		"ci:test:install-methods": "bash scripts/install-tests/run-ci.sh",
		"uat:openai-subscription": "bun packages/coding-agent/scripts/openai-subscription-uat.ts",
		"uat:anthropic-subscription": "bun packages/coding-agent/scripts/anthropic-subscription-uat.ts",
		"uat:eager-todo-providers": "bun packages/coding-agent/scripts/eager-todo-provider-uat.ts",
		"uat:platform-safety-providers": "bun packages/coding-agent/scripts/platform-safety-provider-uat.ts",
		"ci:release:verify-natives": "bun scripts/ci-release-verify-natives.ts",
		"ci:release:verify-native-signing": "bun scripts/ci-release-verify-native-signing.ts",
		"ci:release:build-binaries": "bun scripts/ci-release-build-binaries.ts",
		"ci:release:publish": "bun scripts/ci-release-publish.ts",
		"bench:gen-fixtures": "bun --cwd=packages/typescript-edit-benchmark run src/generate.ts --typescript-dir /tmp/typescript-source --count-per-type 8",
		"bench:edit": "bun --cwd=packages/typescript-edit-benchmark run start",
		"bench:models": "bun packages/coding-agent/bench/model-matrix.ts",
		"bench:context": "bun packages/coding-agent/bench/context.ts",
		"bench:model-scenarios": "bun packages/coding-agent/bench/model-scenarios.ts",
		"bench:model-scenarios:analyze": "bun packages/coding-agent/bench/model-scenario-analysis.ts",
		"bench:model-scenarios:regrade": "bun packages/coding-agent/bench/model-scenario-regrade.ts",
		"prepublishOnly": "bun run check",
		"prepare": "git config core.hooksPath .githooks && bun --cwd=packages/coding-agent run generate-docs-index && bun --cwd=packages/coding-agent run generate-build-info",
		"publish": "bun run prepublishOnly && npm publish -ws --access public",
		"publish:dry": "bun run prepublishOnly && npm publish -ws --access public --dry-run",
		"release": "bun scripts/release.ts",
		"generate-models": "bun --cwd=packages/ai run generate-models",
		"generate-docs-index": "bun --cwd=packages/coding-agent run generate-docs-index",
		"generate-build-info": "bun --cwd=packages/coding-agent run generate-build-info",
		"generate-template": "bun --cwd=packages/coding-agent run generate-template",
		"check-spoofed-versions": "bun scripts/check-spoofed-versions.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4",
		"@bufbuild/protoc-gen-es": "^2.11",
		"@types/bun": "^1.3",
		"@typescript/native-preview": "^7.0.0-dev.20260302.1",
		"lint-staged": "^17.2",
		"prettier": "^3.8",
		"yaml": "2.9.0"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
	},
	"overrides": {
		"adm-zip": "0.6.0",
		"ajv": "^8.20",
		"date-fns": "~4.4.0"
	},
	"patchedDependencies": {
		"beautiful-mermaid@1.1.3": "patches/beautiful-mermaid@1.1.3.patch"
	}
}
